  "name": "Logic Analyzer Test",
  "code": "/*\n * Logic Analyzer Test\n * Generates 4 digital signals at different frequencies:\n *   D2 = 1 Hz   (500ms period)\n *   D3 = 2 Hz   (250ms period)\n *   D4 = 5 Hz   (100ms period)\n *   D5 = 10 Hz  (50ms period)\n *\n * Open the Logic Analyzer tab in the bottom panel.\n * Set CH1=D2, CH2=D3, CH3=D4, CH4=D5.\n * Press Run and observe the square waves!\n */\n\nvoid setup() {\n  pinMode(2, OUTPUT);\n  pinMode(3, OUTPUT);\n  pinMode(4, OUTPUT);\n  pinMode(5, OUTPUT);\n  Serial.println(\"Logic Analyzer Test — 4 channels\");\n}\n\nvoid loop() {\n  digitalWrite(2, HIGH);\n  digitalWrite(3, HIGH);\n  digitalWrite(4, HIGH);\n  digitalWrite(5, HIGH);\n  delay(50);\n\n  digitalWrite(5, LOW);\n  delay(50);\n\n  digitalWrite(4, LOW);\n  delay(50);\n\n  digitalWrite(3, LOW);\n  delay(50);\n\n  digitalWrite(2, LOW);\n  digitalWrite(3, HIGH);\n  digitalWrite(4, HIGH);\n  digitalWrite(5, HIGH);\n  delay(50);\n\n  digitalWrite(5, LOW);\n  delay(50);\n\n  digitalWrite(4, LOW);\n  delay(50);\n\n  digitalWrite(3, LOW);\n  delay(50);\n}\n",
