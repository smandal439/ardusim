  "name": "led_control_using_data",
  "code": "int leds[] = {0,1,2, 3, 4, 5, 6, 7};\nint data = 0;\n\nvoid setup() {\n  for (int i = 0; i < 8; i++) {\n    pinMode(leds[i], OUTPUT);\n  }\n}\n\nvoid loop() {\n  // Update all 8 LEDs to reflect the bits of 'data'\n  for (int i = 0; i < 8; i++) {\n    digitalWrite(leds[i], (data >> i) & 1);\n  }\n  \n  data++; // Increment to the next number\n  \n  // Reset after 255 (8-bit max value is 255)\n  if (data > 255) {\n    data = 0;\n  }\n  \n  delay(500); // Wait 1 second before showing the next number\n}\n\n\n/*\nint data = 0;\n\nvoid setup() {\n  pinMode(11, OUTPUT);\n  pinMode(12, OUTPUT);\n  pinMode(13, OUTPUT);\n}\n\nvoid loop() {\n  digitalWrite(11, (data & 1) ? HIGH : LOW);\n  digitalWrite(12, (data & 2) ? HIGH : LOW);\n  digitalWrite(13, (data & 4) ? HIGH : LOW);\n  \n //digitalWrite(11, (data >> 0) & 1);\n // digitalWrite(12, (data >> 1) & 1);\n //digitalWrite(13, (data >> 2) & 1);\n  \n  data++;\n  delay(100);\n}\n*/",
