  "code": "\r\nint led_array[]={0,1,2,3,4,5,6,7};\r\nvoid setup() {\r\nfor (int i = 0; i < 8; i++) {\r\n  pinMode(led_array[i], OUTPUT);\r\n}\r\n\r\n}\r\nvoid loop() {\r\n  for (int i = 0; i < 8; i++) {\r\n    digitalWrite(led_array[i], HIGH);\r\n    delay(100);\r\n  }\r\n  for (int i = 7; i >= 0; i--) {\r\n    digitalWrite(led_array[i], LOW);\r\n    delay(100);\r\n  }\r\n}",
