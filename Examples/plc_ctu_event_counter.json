{
  "id": "plc_ctu_event_counter",
  "name": "PLC - CTU event counter",
  "icon": "🔢",
  "desc": "Press START (I0.0) five times to reach the CTU preset. Press RESET (I0.3) to clear the count. The relay on Q0.0 indicates the threshold while START is pressed.",
  "tags": ["plc", "ladder", "industrial automation", "counter", "ctu", "relay", "actuator"],
  "code": "",
  "circuit": {
    "components": [
      { "id": "plc_board", "type": "industrial_plc", "x": 0, "y": 0, "rotation": 0, "props": { "label": "ARDU-PLC 328" } },
      { "id": "plc_start", "type": "push_button", "x": -100, "y": 105, "rotation": 0, "props": { "pressed": false, "label": "START", "mode": "momentary" } },
      { "id": "plc_reset", "type": "push_button", "x": -100, "y": 180, "rotation": 0, "props": { "pressed": false, "label": "RESET", "mode": "momentary" } },
      { "id": "plc_relay", "type": "relay", "x": 330, "y": 40, "rotation": 0, "props": { "label": "COUNT RELAY" } },
      { "id": "plc_5v", "type": "power_5v", "x": -160, "y": 0, "rotation": 0, "props": {} }
    ],
    "wires": [
      { "id": "plc_wire_i00", "from": { "instId": "plc_start", "pinId": "p1" }, "to": { "instId": "plc_board", "pinId": "I0_0" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_start_com", "from": { "instId": "plc_start", "pinId": "p2" }, "to": { "instId": "plc_board", "pinId": "COM" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_i03", "from": { "instId": "plc_reset", "pinId": "p1" }, "to": { "instId": "plc_board", "pinId": "I0_3" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_reset_com", "from": { "instId": "plc_reset", "pinId": "p2" }, "to": { "instId": "plc_board", "pinId": "COM" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_relay_vcc", "from": { "instId": "plc_relay", "pinId": "vcc" }, "to": { "instId": "plc_5v", "pinId": "vcc" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_relay_com", "from": { "instId": "plc_relay", "pinId": "gnd" }, "to": { "instId": "plc_board", "pinId": "COM" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_relay_signal", "from": { "instId": "plc_relay", "pinId": "sig" }, "to": { "instId": "plc_board", "pinId": "Q0_0" }, "color": null, "waypoints": [] }
    ],
    "plcProgram": {
      "mode": "ladder",
      "rungs": [{ "elements": [{ "type": "NO", "input": "I0_0" }, { "type": "CTU", "preset": 5, "resetInput": "I0_3" }], "output": "Q0_0" }]
    }
  }
}
