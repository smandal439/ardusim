  "code": "// Row pins: D0-D3 (OUTPUT)\n// Col pins: D4-D7 (INPUT_PULLUP)\n// Press a key on the keypad to see it in Serial Monitor.\n\nconst int rowPins[4] = {0, 1, 2, 3};\nconst int colPins[4] = {4, 5, 6, 7};\n// char keyMap[16] = {'1','2','3','A','4','5','6','B','7','8','9','C','*','0','#','D'};\nString keyMap[16] = {\n  \"1\",\"2\",\"3\",\"A\",\n  \"4\",\"5\",\"6\",\"B\",\n  \"7\",\"8\",\"9\",\"C\",\n  \"*\",\"0\",\"#\",\"D\"\n};\nvoid setup() {\n  Serial.begin(115200);\n  for (int i = 0; i < 4; i++) {\n    pinMode(rowPins[i], OUTPUT);\n    digitalWrite(rowPins[i], HIGH);\n    pinMode(colPins[i], INPUT_PULLUP);\n  }\n}\n\nvoid loop() {\n  for (int r = 0; r < 4; r++) {\n    digitalWrite(rowPins[r], LOW);\n    for (int c = 0; c < 4; c++) {\n      if (digitalRead(colPins[c]) == LOW) {\n        int idx = r * 4 + c;\n        Serial.println(keyMap[idx]);\n        delay(200);\n      }\n    }\n    digitalWrite(rowPins[r], HIGH);\n  }\n  delay(10);\n}"
