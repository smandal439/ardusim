    "sketch.ino": "void setup() {\n  // 555 timer runs autonomously — no code needed!\n}\nvoid loop() {\n  // The 555 OUT pin drives the LED directly.\n  // Frequency is determined by R1, R2, and C:\n  //   f = 1.44 / ((R1 + 2*R2) * C)\n}"
