  "code": "// Define the physical pins\nconst byte buttonPin = 2; // Pin 2 supports external interrupts on Uno/Nano/Mega\nconst byte ledPin = 13;   // The built-in LED pin\n\n// Any variable modified inside an ISR must be declared as 'volatile'\nvolatile bool ledState = false; \n\nvoid setup() {\n  pinMode(ledPin, OUTPUT);\n  \n  // Use INPUT_PULLUP to keep the pin HIGH until the button pulls it to GND\n  pinMode(buttonPin, INPUT_PULLUP); \n  \n  // Link the pin to our ISR function ('toggleLED') to trigger when the voltage falls\n  attachInterrupt(digitalPinToInterrupt(buttonPin), toggleLED, FALLING);\n}\n\nvoid loop() {\n  // The main loop can perform slow tasks or use delays.\n  // The interrupt will cut through this delay instantly!\n  digitalWrite(ledPin, ledState);\n  delay(5000); \n}\n\n// The Interrupt Service Routine (ISR)\nvoid toggleLED() {\n  ledState = !ledState; // Invert the state of the LED\n}\n"
}