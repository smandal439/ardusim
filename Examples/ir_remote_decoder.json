  "code": "/*\n * IR Remote Decoder\n * Receives NEC IR codes from a remote control and prints them\n * to the Serial Monitor. The built-in LED (D13) blinks on each press.\n *\n * Wiring:\n *   TSOP4838 OUT → D2\n *   TSOP4838 VCC → 5V, GND → GND\n *   IR Remote — click any button on the canvas remote to send a code.\n */\n\n#include <IRremote.h>\n\nconst int RECV_PIN = 2;\nIRrecv irrecv(RECV_PIN);\ndecode_results results;\n\nvoid setup() {\n  Serial.begin(115200);\n  irrecv.enableIRIn();\n  pinMode(LED_BUILTIN, OUTPUT);\n  Serial.println(\"IR Remote Decoder ready\");\n  Serial.println(\"Press a button on the remote...\");\n}\n\nvoid loop() {\n  if (irrecv.decode(&results)) {\n    Serial.print(\"Code: 0x\");\n    Serial.print(results.value, HEX);\n    Serial.print(\"  Protocol: \");\n    Serial.println(results.decode_type);\n\n    digitalWrite(LED_BUILTIN, HIGH);\n    delay(100);\n    digitalWrite(LED_BUILTIN, LOW);\n\n    irrecv.resume();\n  }\n}"
