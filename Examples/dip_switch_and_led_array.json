  "code": "int switchs[8] = {0, 1, 2, 3, 4, 5, 6, 7};\nint leds[8] = {8, 9, 10, 11, 12, 13, A0, A1};\n\nvoid setup() {\n  for (int i = 0; i < 8; i++) {\n    pinMode(switchs[i], INPUT_PULLUP);\n  }\n  for (int i = 0; i < 8; i++) {\n    pinMode(leds[i], OUTPUT);\n  }\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  int value = 0;\n  for (int i = 0; i < 8; i++) {\n    if (digitalRead(switchs[i]) == HIGH) {\n      value |= (1 << i);\n    }\n  }\n  \n  for (int i = 7; i >= 0; i--) {\n    digitalWrite(leds[i],(value >> i) & 1);\n  }\n  \n}"
