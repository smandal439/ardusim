  "files": {
    "sketch.ino": "; Intel 8085 - 8-bit Binary Counter on PB\n; Connect 8 LEDs from PB.0-PB.7 to GND\n; Each LED shows one bit of the counter\n\n        MVI A, FFH       ; All PB pins = output\n        OUT 00H           ; Configure PB direction\n        MVI B, 00H       ; B = counter value\n\nLOOP:   MOV A, B         ; Copy counter to A\n        OUT 01H           ; Output to PB port\n        INR B            ; Increment counter (wraps at 255)\n        CALL DELAY        ; Wait between counts\n        JMP LOOP\n\nDELAY:  MVI D, 08H       ; Moderate delay\nDL1:    MVI E, 0FFH\nDL2:    DCR E\n        JNZ DL2\n        DCR D\n        JNZ DL1\n        RET"
  }
