{
  "id": "load_cell_scale",
  "name": "Load Cell Weight Scale",
  "icon": "⚖️",
  "desc": "Read weight from a 5 kg load cell via HX711 amplifier and display on Serial",
  "tags": ["intermediate", "sensor", "load cell", "hx711", "weight"],
  "code": "#include \"HX711.h\"\n\nconst int HX711_DT  = 3;\nconst int HX711_SCK = 2;\n\nHX711 scale(HX711_DT, HX711_SCK);\n\nfloat calibration_factor = 2280.0;\n\nvoid setup() {\n  Serial.begin(115200);\n  Serial.println(\"Load Cell Weight Scale\");\n  Serial.println(\"======================\");\n  Serial.println(\"Tareing...\");\n\n  scale.set_scale(calibration_factor);\n  scale.tare();\n\n  Serial.println(\"Place known weight to calibrate.\");\n}\n\nvoid loop() {\n  float weight = scale.get_units(10);\n\n  if (weight < 0) weight = 0;\n\n  Serial.print(\"Weight: \");\n  Serial.print(weight, 2);\n  Serial.println(\" kg\");\n\n  delay(300);\n}",
