{
  "id": "plc_simple_output_control",
  "name": "PLC - Obstacle relay control",
  "icon": "🏭",
  "desc": "When the IR obstacle sensor detects an object, I0.0 energizes Q0.0 and switches the relay module. Toggle the sensor's Object control to test it.",
  "tags": ["plc", "ladder", "industrial automation", "ir sensor", "relay", "actuator"],
  "code": "",
  "circuit": {
    "components": [
      { "id": "plc_board", "type": "industrial_plc", "x": 0, "y": 0, "rotation": 0, "props": { "label": "ARDU-PLC 328" } },
      { "id": "plc_sensor", "type": "ir_obstacle", "x": -100, "y": -150, "rotation": 0, "props": { "detected": 0 } },
      { "id": "plc_relay", "type": "relay", "x": 330, "y": 40, "rotation": 0, "props": { "label": "OUTPUT RELAY" } },
      { "id": "plc_5v", "type": "power_5v", "x": -130, "y": 10, "rotation": 0, "props": {} }
    ],
    "wires": [
      { "id": "plc_wire_i00", "from": { "instId": "plc_sensor", "pinId": "OUT" }, "to": { "instId": "plc_board", "pinId": "I0_0" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_sensor_vcc", "from": { "instId": "plc_sensor", "pinId": "VCC" }, "to": { "instId": "plc_5v", "pinId": "vcc" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_sensor_com", "from": { "instId": "plc_sensor", "pinId": "GND" }, "to": { "instId": "plc_board", "pinId": "COM" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_relay_vcc", "from": { "instId": "plc_relay", "pinId": "vcc" }, "to": { "instId": "plc_5v", "pinId": "vcc" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_relay_com", "from": { "instId": "plc_relay", "pinId": "gnd" }, "to": { "instId": "plc_board", "pinId": "COM" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_relay_signal", "from": { "instId": "plc_relay", "pinId": "sig" }, "to": { "instId": "plc_board", "pinId": "Q0_0" }, "color": null, "waypoints": [] }
    ],
    "plcProgram": {
      "mode": "ladder",
      "rungs": [{ "elements": [{ "type": "NO", "input": "I0_0" }], "output": "Q0_0" }]
    }
  }
}
