{
  "id": "plc_simple_output_control",
  "name": "PLC - Simple output control",
  "icon": "🏭",
  "desc": "Press the START push button to energize output Q0.0. The button is wired to I0.0 and COM; the PLC input is active-low.",
  "tags": ["plc", "ladder", "industrial automation", "input", "output"],
  "code": "",
  "circuit": {
    "components": [
      { "id": "plc_board", "type": "industrial_plc", "x": 0, "y": 0, "rotation": 0, "props": { "label": "ARDU-PLC 328" } },
      { "id": "plc_start", "type": "push_button", "x": -90, "y": 105, "rotation": 0, "props": { "pressed": false, "label": "START", "mode": "momentary" } }
    ],
    "wires": [
      { "id": "plc_wire_i00", "from": { "instId": "plc_start", "pinId": "p1" }, "to": { "instId": "plc_board", "pinId": "I0_0" }, "color": null, "waypoints": [] },
      { "id": "plc_wire_com", "from": { "instId": "plc_start", "pinId": "p2" }, "to": { "instId": "plc_board", "pinId": "COM" }, "color": null, "waypoints": [] }
    ],
    "plcProgram": {
      "mode": "ladder",
      "rungs": [{ "elements": [{ "type": "NO", "input": "I0_0" }], "output": "Q0_0" }]
    }
  }
}
