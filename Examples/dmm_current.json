{
  "id": "dmm_current",
  "name": "DMM Current Measurement",
  "icon": "🔧",
  "desc": "This is a simple example of measuring current with a digital multimeter (DMM) using an Arduino. The DMM is placed in series to measure current through an LED. The circuit includes a 5V power source, a resistor, a DMM, an LED, and a ground connection. The code reads the current value from the DMM and prints it to the Serial Monitor.",
  "tags": [
    "custom",
    "circuit",
    "dmm",
    "current"
  ],
