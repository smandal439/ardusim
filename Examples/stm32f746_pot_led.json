{
  "id": "stm32f746_pot_led",
  "name": "STM32 Potentiometer + LED",
  "icon": "🎚️",
  "desc": "STM32F746G-DISCO — read a potentiometer on A0 (PA0) and control LED brightness on D5 (PI0) with PWM",
  "tags": [
    "stm32",
    "beginner",
    "analog",
    "sensor",
    "pwm"
  ],
  "circuit": {
    "components": [
      {
        "id": "b1",
        "type": "stm32f746_disco",
        "x": 200,
        "y": 80
      },
      {
        "id": "pot1",
        "type": "potentiometer",
        "x": 100,
        "y": 300
      },
      {
        "id": "led1",
        "type": "led",
        "x": 320,
        "y": 300
      },
      {
        "id": "r1",
        "type": "resistor",
        "x": 320,
        "y": 380
      }
    ],
    "wires": [
      {
        "id": "w1",
        "from": {
          "instId": "b1",
          "pinId": "3V3"
        },
        "to": {
          "instId": "pot1",
          "pinId": "vcc"
        }
      },
      {
        "id": "w2",
        "from": {
          "instId": "pot1",
          "pinId": "wiper"
        },
        "to": {
          "instId": "b1",
          "pinId": "A0"
        }
      },
      {
        "id": "w3",
        "from": {
          "instId": "pot1",
          "pinId": "gnd"
        },
        "to": {
          "instId": "b1",
          "pinId": "GND1"
        }
      },
      {
        "id": "w4",
        "from": {
          "instId": "b1",
          "pinId": "D5"
        },
        "to": {
          "instId": "led1",
          "pinId": "anode"
        }
      },
      {
        "id": "w5",
        "from": {
          "instId": "led1",
          "pinId": "cathode"
        },
        "to": {
          "instId": "r1",
          "pinId": "p1"
        }
      },
      {
        "id": "w6",
        "from": {
          "instId": "r1",
          "pinId": "p2"
        },
        "to": {
          "instId": "b1",
          "pinId": "GND2"
        }
      }
    ]
  },
  "code": "#include \"stm32f7xx.h\"\n\nvoid SystemClock_Config(void);\n\nint main(void) {\n  HAL_Init();\n  SystemClock_Config();\n\n  RCC->AHB1ENR |= RCC_AHB1ENR_GPIOIEN;\n\n  GPIOI->MODER |= (1 << (0 * 2));\n\n  while (1) {\n    GPIOI->ODR |= (1 << 0);\n    HAL_Delay(500);\n    GPIOI->ODR &= ~(1 << 0);\n    HAL_Delay(500);\n  }\n}\n\nvoid SystemClock_Config(void) {\n}"
}
