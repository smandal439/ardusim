  "files": {
    "sketch.ino": "void setup() {\n  DDRD = 0xFF;\n}\n\nvoid loop() {\n  data=1;\n  for (int i = 0; i < 8; i++) {\n    PORTD=data<<i;\n    delay(100);\n  }\n  for (int i = 7; i >=0; i--) {\n    PORTD=data<<i;\n    delay(100);\n  }\n}\n"
  }
