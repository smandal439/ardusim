{
  "id": "ir_obstacle_led",
  "name": "IR Obstacle Sensor LED Alert",
  "icon": "📡",
  "desc": "IR obstacle sensor triggers LED when an object is detected",
  "tags": ["sensor", "ir", "led", "beginner"],
  "code": "int sensorPin = 2;\nint ledPin = 13;\n\nvoid setup() {\n  pinMode(sensorPin, INPUT);\n  pinMode(ledPin, OUTPUT);\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  int state = digitalRead(sensorPin);\n  if (state == LOW) {\n    digitalWrite(ledPin, HIGH);\n    Serial.println(\"Obstacle detected!\");\n  } else {\n    digitalWrite(ledPin, LOW);\n    Serial.println(\"Clear\");\n  }\n  delay(100);\n}",
  "circuit": {
    "components": [
      {
        "id": "b1",
        "type": "arduino_uno",
        "x": 100,
        "y": 100,
        "width": 230,
        "height": 150,
        "props": { "label": "UNO" },
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
        "id": "ir1",
        "type": "ir_obstacle",
        "x": 420,
        "y": 120,
        "width": 60,
        "height": 50,
        "props": { "detected": 0 },
        "runtimeState": { "detected": 0, "OUT": 1 },
        "selected": false,
        "rotation": 0
      },
      {
        "id": "led1",
        "type": "led",
        "x": 420,
        "y": 230,
        "width": 30,
        "height": 60,
        "props": { "color": "#ff3333", "colorName": "Red" },
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
        "id": "r1",
        "type": "resistor",
        "x": 425,
        "y": 310,
        "width": 20,
        "height": 60,
        "props": { "value": 220, "unit": "\u03a9" },
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
        "id": "vcc1",
        "type": "power_5v",
        "x": 530,
        "y": 100,
        "width": 30,
        "height": 30,
        "props": {},
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
        "id": "gnd1",
        "type": "power_gnd",
        "x": 530,
        "y": 350,
        "width": 30,
        "height": 30,
        "props": {},
