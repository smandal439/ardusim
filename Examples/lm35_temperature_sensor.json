  "code": "#include <Wire.h>\r\n#include <LiquidCrystal_I2C.h>\r\n\r\nLiquidCrystal_I2C lcd(0x27, 16, 2);\r\nconst int sensorPin = A5;\r\n\r\nvoid setup() {\r\n  Serial.begin(115200);\r\n  lcd.init();\r\n  lcd.backlight();\r\n  lcd.setCursor(0, 0);\r\n  lcd.print(\"Hello, ArduSim!\");\r\n  lcd.setCursor(0, 1);\r\n  lcd.print(\"LCD I2C : 0x27\");\r\n}\r\n\r\nvoid loop() {\r\n  int sensorValue = analogRead(sensorPin);\r\n  \r\n  float temperatureCelsius = (sensorValue * 500.0) / 1023.0;\r\n  float temperatureFahrenheit = (temperatureCelsius * 1.8) + 32.0;\r\n\r\n  Serial.print(\"Temperature: \");\r\n  Serial.print(temperatureCelsius);\r\n  Serial.print(\" °C  |  \");\r\n  Serial.print(temperatureFahrenheit);\r\n  Serial.println(\" °F\");\r\n  lcd.clear();\r\n  lcd.setCursor(0, 0);\r\n  lcd.print(\"Temp: \");\r\n  lcd.print(temperatureCelsius);\r\n  lcd.print(\"°C \");\r\n  lcd.setCursor(0, 1); \r\n  lcd.print(\"      \") ;\r\n  lcd.print(temperatureFahrenheit);\r\n  lcd.print(\"°F\");\r\n  delay(1000);\r\n}"
