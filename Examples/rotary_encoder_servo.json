        "width": 40,
        "height": 50,
        "props": { "position": 90, "pressed": false },
        "runtimeState": { "position": 90, "pressed": false },
        "selected": false,
        "rotation": 0
      },
      {
        "id": "sv1",
        "type": "servo",
        "x": 420,
        "y": 230,
        "width": 60,
        "height": 50,
        "props": { "angle": 90 },
        "runtimeState": { "angle": 90 },
        "selected": false,
        "rotation": 0
      },
      {
