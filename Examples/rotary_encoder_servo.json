{
  "id": "rotary_encoder_servo",
  "name": "Rotary Encoder Servo Position Control",
  "icon": "🎛️",
  "desc": "Turn rotary encoder to set servo angle 0-180 with push button to reset to center",
  "tags": ["servo", "encoder", "input", "actuator", "position"],
  "code": "int encA = 2;\nint encB = 3;\nint swPin = 4;\nint servoPin = 9;\nint counter = 90;\nint lastA = LOW;\n\nvoid setup() {\n  pinMode(encA, INPUT_PULLUP);\n  pinMode(encB, INPUT_PULLUP);\n  pinMode(swPin, INPUT_PULLUP);\n  pinMode(servoPin, OUTPUT);\n  Serial.begin(115200);\n  lastA = digitalRead(encA);\n}\n\nvoid loop() {\n  int curA = digitalRead(encA);\n  int curB = digitalRead(encB);\n  if (curA != lastA) {\n    if (curA == HIGH) {\n      counter += (curB == HIGH) ? 1 : -1;\n    } else {\n      counter += (curB == HIGH) ? -1 : 1;\n    }\n    counter = constrain(counter, 0, 180);\n    lastA = curA;\n  }\n  if (digitalRead(swPin) == LOW) {\n    counter = 90;\n    delay(200);\n  }\n  int duty = map(counter, 0, 180, 0, 255);\n  analogWrite(servoPin, duty);\n  Serial.print(\"Angle: \");\n  Serial.println(counter);\n  delay(20);\n}",
  "circuit": {
    "components": [
      {
        "id": "b1",
        "type": "arduino_uno",
        "x": 80,
        "y": 120,
        "width": 230,
        "height": 150,
        "props": { "label": "UNO" },
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
