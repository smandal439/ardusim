    "sketch.ino": "void setup() {\n  Serial.begin(115200);\n}\n\nvoid loop() {\nfor (int i = 0; i < 255; i++) {\n  analogWrite(6, i);\n  delay(10);\n}\nfor (int i = 255; i >=0; i--) {\n  analogWrite(6, i);\n  delay(10);\n}\n}"
