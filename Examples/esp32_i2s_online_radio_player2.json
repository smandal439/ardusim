  "files": {
    "sketch.ino": "#include \"WiFi.h\"\n#include \"Audio.h\"\n\n// Define I2S Pins\n#define I2S_BCLK 26\n#define I2S_LRC  25\n#define I2S_DOUT 22\n\nAudio audio;\n\n// Wi-Fi Credentials\nconst char* ssid     = \"ArduSim_WiFi\";\nconst char* password = \"ArduSim@123\";\n\n// Streaming URL (MP3 / AAC web radio stream)\nconst char* streamUrl = \"http://stream.zeno.fm/f3wvbb28g2zuv\";\n\nvoid setup() {\n    Serial.begin(115200);\n\n    // Connect to Wi-Fi\n    WiFi.disconnect();\n    WiFi.mode(WIFI_STA);\n    WiFi.begin(ssid, password);\n\n    Serial.print(\"Connecting to WiFi\");\n    while (WiFi.status() != WL_CONNECTED) {\n        delay(500);\n        Serial.print(\".\");\n    }\n    Serial.println(\"\\nConnected to WiFi!\");\n\n    // Initialize I2S Audio\n    audio.setPinout(I2S_BCLK, I2S_LRC, I2S_DOUT);\n    audio.setVolume(12); // Volume level from 0 to 21\n\n    // Connect to the web radio stream\n    audio.connecttohost(streamUrl);\n}\n\nvoid loop() {\n    // Keep processing the audio stream buffer\n    audio.loop();\n}\n\n// Optional callback functions to print track metadata\nvoid audio_info(const char *info) {\n    Serial.print(\"info: \"); \n    Serial.println(info);\n}\n\nvoid audio_showstreamtitle(const char *title) {\n    Serial.print(\"Now Playing: \"); \n    Serial.println(title);\n}"
