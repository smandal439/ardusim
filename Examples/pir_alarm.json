{
  "id": "pir_alarm",
  "name": "PIR Motion Alarm",
  "icon": "🚶",
  "desc": "PIR motion sensor on D2 — when Motion is ON the LED on D13 lights and the console prints it",
  "tags": [
    "beginner",
    "sensor",
    "motion"
  ],
  "circuit": {
    "components": [
      {
        "id": "b1",
        "type": "arduino_uno",
        "x": 200,
        "y": 100
      },
      {
        "id": "pir1",
        "type": "pir",
        "x": 120,
        "y": 300
      },
      {
        "id": "led1",
        "type": "led",
        "x": 340,
        "y": 260
      },
      {
        "id": "r1",
        "type": "resistor",
        "x": 340,
        "y": 340
      }
    ],
    "wires": [
      {
        "id": "w1",
        "from": {
          "instId": "b1",
          "pinId": "5V"
        },
        "to": {
          "instId": "pir1",
          "pinId": "vcc"
        }
      },
      {
        "id": "w2",
        "from": {
          "instId": "pir1",
          "pinId": "out"
        },
        "to": {
          "instId": "b1",
          "pinId": "D2"
        }
      },
      {
        "id": "w3",
        "from": {
          "instId": "pir1",
          "pinId": "gnd"
        },
        "to": {
          "instId": "b1",
          "pinId": "GND1"
        }
      },
      {
        "id": "w4",
        "from": {
          "instId": "b1",
          "pinId": "D13"
        },
        "to": {
          "instId": "led1",
          "pinId": "anode"
        }
      },
      {
        "id": "w5",
        "from": {
          "instId": "led1",
          "pinId": "cathode"
        },
        "to": {
          "instId": "r1",
          "pinId": "p1"
        }
      },
      {
        "id": "w6",
        "from": {
          "instId": "r1",
          "pinId": "p2"
        },
        "to": {
          "instId": "b1",
          "pinId": "GND1"
        }
      }
    ]
  },
  "code": "/*\n * PIR Motion Alarm — detect motion on D2\n * Flip the \"Motion\" slider ON to trigger the LED and alarm messages.\n */\n\nint pirPin = 2;\nint ledPin = 13;\n\nvoid setup() {\n  pinMode(pirPin, INPUT);\n  pinMode(ledPin, OUTPUT);\n  Serial.begin(115200);\n  Serial.println(\"PIR alarm armed\");\n}\n\nvoid loop() {\n  int motion = digitalRead(pirPin);\n\n  if (motion == HIGH) {\n    digitalWrite(ledPin, HIGH);\n    Serial.println(\"MOTION DETECTED!\");\n  } else {\n    digitalWrite(ledPin, LOW);\n  }\n  delay(200);\n}"
}