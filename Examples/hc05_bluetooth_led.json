{
  "id": "hc05_bluetooth_led",
  "name": "HC-05 Bluetooth LED Control",
  "icon": "📶",
  "desc": "Toggle LED on/off via Bluetooth using HC-05 module and Serial communication",
  "tags": ["bluetooth", "hc05", "uart", "led", "wireless"],
  "code": "int ledPin = 13;\nbool ledState = false;\n\nvoid setup() {\n  pinMode(ledPin, OUTPUT);\n  Serial.begin(115200);\n  digitalWrite(ledPin, LOW);\n}\n\nvoid loop() {\n  if (Serial.available() > 0) {\n    char c = Serial.read();\n    if (c == '1') {\n      ledState = true;\n      digitalWrite(ledPin, HIGH);\n      Serial.println(\"LED ON\");\n    } else if (c == '0') {\n      ledState = false;\n      digitalWrite(ledPin, LOW);\n      Serial.println(\"LED OFF\");\n    }\n  }\n  delay(50);\n}",
  "circuit": {
    "components": [
      {
        "id": "b1",
        "type": "arduino_uno",
        "x": 100,
        "y": 120,
        "width": 230,
        "height": 150,
        "props": { "label": "UNO" },
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
        "id": "bt1",
        "type": "hc05",
        "x": 420,
        "y": 120,
        "width": 50,
        "height": 70,
        "props": { "connected": false, "rxData": "" },
        "runtimeState": { "connected": false, "rxData": "" },
        "selected": false,
        "rotation": 0
      },
      {
        "id": "led1",
        "type": "led",
        "x": 420,
        "y": 260,
        "width": 30,
        "height": 60,
        "props": { "color": "#ff3333", "colorName": "Red" },
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
        "id": "r1",
        "type": "resistor",
        "x": 425,
        "y": 330,
        "width": 20,
        "height": 60,
        "props": { "value": 220, "unit": "\u03a9" },
        "runtimeState": {},
        "selected": false,
        "rotation": 0
      },
      {
        "id": "vcc1",
        "type": "power_5v",
        "x": 530,
