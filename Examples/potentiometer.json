{
  "id": "potentiometer",
  "name": "Potentiometer Read",
  "icon": "🎚️",
  "desc": "Read a potentiometer on A0 and display the value",
  "tags": [
    "beginner",
    "analog",
    "sensor"
  ],
  "circuit": {
    "components": [
      {
        "id": "b1",
        "type": "arduino_uno",
