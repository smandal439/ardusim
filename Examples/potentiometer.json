        "to": {
          "instId": "b1",
          "pinId": "A0"
        }
      },
      {
        "id": "w3",
        "from": {
          "instId": "pot1",
          "pinId": "gnd"
        },
        "to": {
          "instId": "b1",
          "pinId": "GND1"
        }
      },
      {
        "id": "w4",
        "from": {
