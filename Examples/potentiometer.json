        "y": 100
      },
      {
        "id": "pot1",
        "type": "potentiometer",
        "x": 120,
        "y": 300
      },
      {
        "id": "led1",
        "type": "led",
        "x": 340,
        "y": 260
      },
      {
        "id": "r1",
        "type": "resistor",
        "x": 340,
        "y": 340
      }
    ],
    "wires": [
      {
        "id": "w1",
        "from": {
          "instId": "b1",
          "pinId": "5V"
        },
        "to": {
