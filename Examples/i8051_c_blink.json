    "sketch.c": "#include <reg51.h>\n\nsbit LED = P1^7;\n\nvoid delay(unsigned int n) {\n  while (n--) ;\n}\n\nvoid main(void) {\n  while (1) {\n    LED = 0;          /* LED ON  (active low) */\n    delay(20000);\n    LED = 1;          /* LED OFF */\n    delay(20000);\n  }\n}\n"
